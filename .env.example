# Chain (contracts/.env for Foundry; apps/web/.env.local for the web app)
RPC_URL=
DEPLOYER_PRIVATE_KEY=

# Web app accepts several comma-separated RPC URLs and falls back in order if one is down, e.g.
# RPC_URL=https://polygon-amoy.drpc.org,https://polygon-amoy-bor-rpc.publicnode.com,https://polygon-amoy.gateway.tenderly.co
# Deployed MockINR token address on the target testnet (web app reads balances from it)
MOCK_INR_ADDRESS=

# Database: local SQLite file path (created automatically), relative to apps/web
DATABASE_URL=./data/vera.db

# Auth: random string of 32+ characters used to sign session cookies
AUTH_SECRET=

# 64 hex characters (32 bytes); encrypts generated demo-wallet keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=

# Indexer (web app): reads campaign and donation events straight from the chain.
# FACTORY_ADDRESS is public, so setting it alone is safe. INDEXER_START_BLOCK is the block the
# Factory was deployed in (scanning from genesis would take hours). The indexer stays off, and
# says so, if either is missing. Optional tuning: INDEXER_CONFIRMATIONS (default 2) and
# INDEXER_MAX_RANGE (default 2000 blocks per read; it shrinks itself if an RPC refuses it).
INDEXER_START_BLOCK=

# Optional (web app): mirror organizer approvals and publish campaigns on-chain. Needs BOTH
# FACTORY_ADDRESS and FACTORY_OWNER_KEY; without the key those features stay off.
# FACTORY_OWNER_KEY is the private key of the CampaignFactory owner. It controls the Factory,
# so use a testnet key only, and never commit it. Without these, approvals are recorded in the
# app only and the admin console shows "on-chain sync is not configured".
FACTORY_ADDRESS=
FACTORY_OWNER_KEY=

# Donations (web app): need FACTORY_OWNER_KEY above (donor wallets have no POL, so the platform
# sponsors gas; roughly 0.03 POL for a donor's first donation, less afterwards). Without the key,
# the campaign page says donations are switched off.
# Optional flat fee per donation in mINR minor units (6 decimals; 2000000 = 2 rupees). Default 0.
# If set, PLATFORM_FEE_ADDRESS is required, and donors get an explicit, never pre-selected choice
# between covering it and "no thanks". Addresses are checksum-validated when the server starts.
PLATFORM_FEE_MINOR_UNITS=
PLATFORM_FEE_ADDRESS=

# Milestone manager (Step 4/11/12): the shared MilestoneManager contract and the block it was
# deployed in (Amoy: 0xe6d7222dDe3eE4b9688269427631aDF49229e747, block 47997230). Both are public.
# With the address set (and FACTORY_OWNER_KEY, which is also the manager's owner) milestones can
# be registered, attested, approved and released; with MANAGER_START_BLOCK too, the indexer
# reads its events so releases reach the public ledger.
MILESTONE_MANAGER_ADDRESS=
MANAGER_START_BLOCK=

# Beneficiary registry (Step 13): the BeneficiaryRegistry contract. With it set (and
# FACTORY_OWNER_KEY, which sponsors gas) an organizer can register beneficiaries; each is a salted
# hash made in the browser and can register once per campaign. Empty until it is deployed.
BENEFICIARY_REGISTRY_ADDRESS=
